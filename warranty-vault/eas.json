{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EXTRACT_API_URL": "http://localhost:3000/api/extract-warranty"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EXTRACT_API_URL": "https://YOUR-PROXY.vercel.app/api/extract-warranty"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_EXTRACT_API_URL": "https://YOUR-PROXY.vercel.app/api/extract-warranty"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": ""
      }
    }
  }
}
