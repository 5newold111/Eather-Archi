{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artist_sheet.schema.json",
  "title": "アーティスト設定書（1 組ぶん）",
  "description": "artists テーブルの sheet 列に入れる JSON。名前は配信登録後に変えない。",
  "type": "object",
  "required": [
    "slug",
    "axis",
    "name",
    "formation",
    "vocal",
    "sound",
    "lyrics",
    "visual",
    "distribution"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "フォルダ名などに使う英小文字"
    },
    "axis": {
      "type": "string",
      "enum": [
        "shape",
        "quality",
        "light",
        "time",
        "self"
      ],
      "description": "形 / 質 / 光 / 時 / 自"
    },
    "name": {
      "type": "string",
      "description": "配信名。登録前に Spotify / Apple Music / YouTube / Instagram / TikTok / 商標 を検索して重複がないこと"
    },
    "name_status": {
      "type": "string",
      "enum": [
        "draft",
        "checked",
        "registered"
      ],
      "description": "draft：仮 / checked：重複確認済み / registered：配信登録済み"
    },
    "name_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formation": {
      "type": "string",
      "enum": [
        "solo",
        "duo",
        "band",
        "producer"
      ]
    },
    "cadence": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly"
      ],
      "default": "weekly",
      "description": "リリース頻度。週の総曲数が上限（8）を超えたら古い組から biweekly に"
    },
    "debut_week": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "デビュー週の月曜"
    },
    "persona": {
      "type": "object",
      "description": "人物像・物語",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "age_feel": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "drive_scene": {
          "type": "string",
          "description": "このアーティストが担当するドライブの場面"
        },
        "origin": {
          "type": "object",
          "description": "生まれと育ち",
          "properties": {
            "birthplace": {
              "type": "string"
            },
            "upbringing": {
              "type": "string"
            },
            "landscape_words": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Suno に渡す風景・質感の言葉。地名は渡さない"
            }
          }
        },
        "influences": {
          "type": "array",
          "description": "影響源。name は bio にのみ。指示文には era / genre / what_was_taken だけ",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "era": {
                "type": "string"
              },
              "genre": {
                "type": "string"
              },
              "what_was_taken": {
                "type": "string"
              },
              "reference_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "formation_story": {
          "type": "object",
          "description": "結成・活動開始のエピソード。実在アーティストの結成パターンを『型』として参考にし、中身は架空",
          "properties": {
            "started": {
              "type": "string"
            },
            "how": {
              "type": "string"
            },
            "inspired_by_pattern": {
              "type": "string",
              "description": "参考にした結成パターン（型の説明。bio には書かない）"
            },
            "first_release": {
              "type": "string"
            },
            "name_meaning": {
              "type": "string"
            }
          }
        }
      }
    },
    "composition_habits": {
      "type": "object",
      "description": "作曲の癖。毎週のブリーフに固定の制約として入る",
      "properties": {
        "modulation": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "outro": {
          "type": "string"
        },
        "phrase_endings": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        },
        "instruments_rule": {
          "type": "string"
        },
        "rhythm": {
          "type": "string"
        },
        "lyrics_tic": {
          "type": "string"
        },
        "always": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vocal": {
      "type": "object",
      "description": "声の設定。二層運用の『声質（固定）』をここに置く",
      "required": [
        "sex",
        "fixed_timbre"
      ],
      "properties": {
        "sex": {
          "type": "string",
          "enum": [
            "female",
            "male",
            "mixed",
            "none"
          ]
        },
        "range": {
          "type": "string",
          "enum": [
            "low",
            "mid",
            "high"
          ]
        },
        "fixed_timbre": {
          "type": "boolean",
          "description": "true：声質を Persona で固定 / false：曲ごとに声質も変える（自 など）"
        },
        "suno_persona_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Suno の Persona ID。声の試作が終わったら記入"
        },
        "voice_spec": {
          "type": "object",
          "description": "歌手としての体の仕様。組ごとに必ず違う値にする",
          "properties": {
            "comfortable_low": {
              "type": "string",
              "description": "楽に出る下端（音名。例：G2）"
            },
            "comfortable_high": {
              "type": "string",
              "description": "楽に出る上端（音名。例：E4）"
            },
            "chest_voice_top": {
              "type": "string",
              "description": "地声の上限"
            },
            "falsetto_switch_point": {
              "type": "string",
              "description": "裏声に切り替わる高さ（例：F#4）"
            },
            "falsetto_quality": {
              "type": "string",
              "description": "裏声の質"
            },
            "strength": {
              "type": "string",
              "description": "得意（低音の響き / 高音のロングトーン …）"
            },
            "weakness": {
              "type": "string",
              "description": "苦手。曲作りで避ける"
            }
          }
        },
        "signature_techniques": {
          "type": "object",
          "description": "得意な歌い方（キャラクターの核）",
          "properties": {
            "primary": {
              "type": "string",
              "description": "一番の武器 1 つ"
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "この組がやらない歌い方"
            },
            "wordless_style": {
              "type": "string",
              "description": "歌詞のない部分の歌い方（la-la-la / ooh / ハミング / 口笛 / 無言）"
            },
            "tics": {
              "type": "array",
              "description": "毎曲入れる癖。ブリーフに固定で入り、Suno の歌詞タグ（[Humming] など）や歌唱指示に変換される",
              "items": {
                "type": "object",
                "required": [
                  "technique",
                  "where",
                  "frequency"
                ],
                "properties": {
                  "technique": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string",
                    "description": "イントロ / サビ前 / 間奏 / アウトロ など"
                  },
                  "frequency": {
                    "type": "string",
                    "enum": [
                      "every_song",
                      "most",
                      "sometimes"
                    ]
                  }
                }
              }
            }
          }
        },
        "melodic_tendency": {
          "type": "object",
          "properties": {
            "motion": {
              "type": "string"
            },
            "chorus_peak": {
              "type": "string",
              "description": "サビの最高音を切り替え点に対してどこに置くか"
            },
            "verse_register": {
              "type": "string"
            }
          }
        },
        "timbre_blend": {
          "type": "object",
          "description": "声質の 6:2:2 配合。参考曲の解析シートから形容詞を合成する。実在アーティスト名は書かない",
          "properties": {
            "main": {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "weight": {
                  "const": 0.6
                },
                "traits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "sub1": {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "weight": {
                  "const": 0.2
                },
                "traits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "sub2": {
              "type": "object",
              "properties": {
                "reference_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "weight": {
                  "const": 0.2
                },
                "traits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "synthesized": {
              "type": "string",
              "description": "合成した声質の説明文（Suno の Persona 作成時の指示に使う）"
            }
          }
        },
        "guest_description": {
          "type": "string",
          "description": "他アーティストの曲に客演するときに、相手のブリーフへそのまま貼る声の描写"
        }
      }
    },
    "sound": {
      "type": "object",
      "required": [
        "bpm_min",
        "bpm_max"
      ],
      "properties": {
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "楽器パレット"
        },
        "bpm_min": {
          "type": "integer"
        },
        "bpm_max": {
          "type": "integer"
        },
        "energy_curve_type": {
          "type": "string",
          "description": "例：3-5-8-5-8-4-10-3（セクションごとの 10 段階）"
        },
        "dna_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "参考曲を絞るタグ。reference_tracks.tags と照合"
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "禁止事項（例：悲しい結末、急な無音）"
        },
        "drive_spec": {
          "type": "object",
          "description": "ドライブ向けの共通仕様",
          "properties": {
            "hook_within_sec": {
              "type": "integer",
              "default": 30
            },
            "length_sec_min": {
              "type": "integer",
              "default": 150
            },
            "length_sec_max": {
              "type": "integer",
              "default": 210
            },
            "no_sudden_silence": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "lyrics": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "point_of_view": {
          "type": "string"
        },
        "primary_language": {
          "type": "string",
          "default": "en"
        },
        "trend_language_ok": {
          "type": "boolean",
          "description": "トレンド言語のフレーズを混ぜてよいか（質 だけ true）"
        },
        "trend_language_max_ratio": {
          "type": "number",
          "default": 0.2
        },
        "tone": {
          "type": "string"
        },
        "forbidden_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "description": "Blender で作る『そのアーティストの空間』。ジャケットも SNS 動画もここから生成する",
      "properties": {
        "space": {
          "type": "string",
          "description": "例：朝日の差す 6 畳の部屋、夜の車内"
        },
        "light": {
          "type": "string"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "camera": {
          "type": "string"
        },
        "cover_series_rule": {
          "type": "string",
          "description": "ジャケットをシリーズとして統一するルール"
        },
        "blend_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "covers/{slug}/scene.blend"
        },
        "face_concealment": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "never": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "logo": {
          "type": "object",
          "properties": {
            "concept": {
              "type": "string"
            },
            "mark_type": {
              "type": "string",
              "enum": [
                "文字のみ",
                "文字＋記号",
                "記号のみ"
              ]
            },
            "color_rule": {
              "type": "string"
            },
            "typography": {
              "type": "string"
            }
          }
        },
        "photo_direction": {
          "type": "object",
          "description": "アーティスト写真の方向（参考分析の手法を自分の言葉で）",
          "properties": {
            "taste": {
              "type": "string"
            },
            "composition": {
              "type": "string"
            },
            "location_type": {
              "type": "string"
            },
            "brightness": {
              "type": "string"
            },
            "contrast": {
              "type": "string"
            },
            "background": {
              "type": "string"
            },
            "positioning": {
              "type": "string"
            },
            "gesture": {
              "type": "string"
            }
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "properties": {
        "spotify_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "apple_artist_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "distrokid_artist_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "youtube_channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "instagram": {
          "type": [
            "string",
            "null"
          ]
        },
        "tiktok": {
          "type": [
            "string",
            "null"
          ]
        },
        "bio_en": {
          "type": "string",
          "description": "各ストアのプロフィール用。AI と空間デザインで作っていることを明記"
        }
      }
    },
    "collab": {
      "type": "object",
      "properties": {
        "preferred_partners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "slug の配列"
        },
        "collab_style": {
          "type": "string",
          "description": "feat. で客演 / remix で再構築 など"
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "hometown": {
          "type": "string"
        },
        "height_cm": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "weight_kg": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "likes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "favorite_food": {
          "type": "string"
        },
        "dislikes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "favorite_artists_real": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "bio と SNS 用。生成の指示文には渡さない"
        }
      }
    },
    "concept_history": {
      "type": "object",
      "properties": {
        "concept_version": {
          "type": "integer"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer"
              },
              "date": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "changes": {
                "type": "object"
              },
              "photos_reshot": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
