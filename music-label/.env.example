# このファイルを .env にコピーして値を入れる（.env は Git に入らない）

# OpenAI（ChatGPT 側）の画像 API。ロゴ・アーティスト写真・ジャケットの生成に使う
# https://platform.openai.com/api-keys で作成した sk- から始まる鍵
OPENAI_API_KEY=
# 画像モデル（setup_keys.py か generate_visuals.py が自動で書き込む。gpt-image-1 は 2026-10-23 終了）
OPENAI_IMAGE_MODEL=

# Supabase（docs/05_storage.md の手順 1 で控える）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2（予備保管）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=label-backup

# Claude API（ブリーフ生成に使う）
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# SNS 自動投稿（scripts/post_social.py）。手順は docs/09_auth_batch.md
# 組・レーベルごとに別アカウントにするときは、名前の後ろに __組 か __レーベル を付けた行を足す
#   例）YOUTUBE_REFRESH_TOKEN__LIGHT=…   IG_USER_ID__FOCUS=…
# ---------------------------------------------------------------------------
# YouTube（Google Cloud の OAuth クライアント。REFRESH_TOKEN は oauth_youtube.py が自動で書き込む）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram（プロアカウント。Instagram ログイン方式のアプリで発行した長期トークン）
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com

# TikTok（Content Posting API を有効にした開発者アプリ）
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
