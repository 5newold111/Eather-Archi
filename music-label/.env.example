# このファイルを .env にコピーして値を入れる（.env は Git に入らない）

# OpenAI（ChatGPT 側）の画像 API。ロゴ・アーティスト写真・ジャケットの生成に使う
# https://platform.openai.com/api-keys で作成した sk- から始まる鍵
OPENAI_API_KEY=
# 画像モデル（setup_keys.py か generate_visuals.py が自動で書き込む。gpt-image-1 は 2026-10-23 終了）
OPENAI_IMAGE_MODEL=

# アーティストの情報・写真・ジャケット・楽曲・管理表の保管庫（外付け SSD「DS72」）。管理表はここにしか無い。
# 名前に DS72 を含むドライブがつながっていれば自動で見つけるので、普通は空のままでよい。
# 見つからないときは python3 scripts/archive_sync.py --setup /Volumes/<SSD の名前> で書き込む
# ARCHIVE_ROOT=/Volumes/DS72/Postdog Records

# Supabase（docs/05_storage.md の手順 1 で控える）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2（予備保管。SSD の中身も毎晩ここへ。python3 scripts/setup_keys.py --only r2 で設定）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=label-backup

# Claude API（ブリーフ生成に使う）
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# SNS 自動投稿（scripts/post_social.py）。手順は docs/09_auth_batch.md
# 組・レーベルごとに別アカウントにするときは、名前の後ろに __組 か __レーベル を付けた行を足す
#   例）YOUTUBE_REFRESH_TOKEN__LIGHT=…   IG_USER_ID__FOCUS=…
# ---------------------------------------------------------------------------
# YouTube（Google Cloud の OAuth クライアント。REFRESH_TOKEN は oauth_youtube.py が自動で書き込む）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram（プロアカウント。Instagram ログイン方式のアプリで発行した長期トークン）
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com

# TikTok（Content Posting API を有効にした開発者アプリ）
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=

# ローカル保存（一時保存）の場所（空ならダウンロード/SUNO楽曲/ローカル保存（一時保存））。SSD が無くても音源・画像はここにそろう
# LOCAL_ARCHIVE=
# SSD の参考データベースの場所（空なら SSD の中の「データベース」などの名前を自動で探す。reference_db.py --setup で書ける）
# REFERENCE_DB=

# 公開の流れ（publish.py）
# Spotify：配信が始まったかの確認と ISRC・UPC・配信 URL の自動記録（python3 scripts/setup_keys.py --only spotify）
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# DistroKid の作詞作曲者の欄に入れる本名（この .env にだけ書く。GitHub には入らない）
# OWNER_LEGAL_NAME=
# Suno からダウンロードした曲を入れるフォルダ（空ならダウンロード/SUNO楽曲）
# SUNO_INBOX=

# ダッシュボードのウェブアプリ（webapp.py）
# WEBAPP_PORT=8765
# スマホから見るとき（--lan）の合鍵。空なら最初の起動で自動で作ってここに書く
# WEBAPP_KEY=
